<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Chaque section est un TitledPane : un clic sur son titre la replie ou la déplie -->
<ScrollPane fx:id="defilement" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ci.inphb.election.vue.ControleurAnalyses" fitToWidth="true" styleClass="onglet">
    <VBox fx:id="contenu" spacing="10">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

        <HBox spacing="8" styleClass="entete-onglet">
            <Pane fx:id="zoneTitre" HBox.hgrow="ALWAYS" minWidth="0">
                <HBox fx:id="titreDefilant" spacing="12" alignment="CENTER_LEFT">
                    <Label text="Tableau de bord de l'élection" styleClass="titre"/>
                    <Label text="Toutes les réponses aux questions du scrutin, section par section" styleClass="astuce"/>
                </HBox>
            </Pane>
            <Button text="Tout déplier" onAction="#toutDeplier" styleClass="bouton-secondaire"/>
            <Button text="Tout replier" onAction="#toutReplier" styleClass="bouton-secondaire"/>
        </HBox>

        <TitledPane fx:id="panneauNational" text="Résultat national : composition de l'Assemblée (un député par département)">
            <VBox spacing="8">
                <Label fx:id="conclusionNationale" styleClass="chiffre-cle" wrapText="true"/>
                <Label text="Survolez une barre pour voir le détail. Un clic sur une barre ou sur un parti affiche les départements qu'il a gagnés."
                       styleClass="astuce" wrapText="true"/>
                <HBox spacing="10">
                    <TableView fx:id="tableNationale" prefHeight="230" HBox.hgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder><Label text="Aucun parti enrôlé"/></placeholder>
                        <columns>
                            <TableColumn fx:id="colNatParti" text="Parti" minWidth="200"/>
                            <TableColumn fx:id="colNatSieges" text="Sièges" styleClass="nombre" minWidth="60" maxWidth="90"/>
                            <TableColumn fx:id="colNatPartSieges" text="\% des sièges" styleClass="nombre" minWidth="90"/>
                            <TableColumn fx:id="colNatVoix" text="Voix" styleClass="nombre" minWidth="70"/>
                            <TableColumn fx:id="colNatPartVoix" text="\% des voix" styleClass="nombre" minWidth="80"/>
                        </columns>
                    </TableView>
                    <BarChart fx:id="graphiqueSieges" legendVisible="false" animated="false" prefHeight="230" prefWidth="380">
                        <xAxis><CategoryAxis label="Parti"/></xAxis>
                        <yAxis><NumberAxis label="Sièges" tickUnit="1" minorTickVisible="false"/></yAxis>
                    </BarChart>
                </HBox>
            </VBox>
        </TitledPane>

        <TitledPane fx:id="panneauStatistiques" text="Taux de participation général et statistiques de participation">
            <VBox spacing="8">
                <Label fx:id="tauxGeneral" styleClass="chiffre-cle"/>
                <Label text="Cliquez sur une barre de l'histogramme pour voir les départements de cette tranche."
                       styleClass="astuce" wrapText="true"/>
                <HBox spacing="20">
                    <GridPane hgap="14" vgap="6" styleClass="statistiques">
                        <Label text="Départements pris en compte" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="statEffectif" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="valeur"/>
                        <Label text="Moyenne" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="statMoyenne" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="valeur"/>
                        <Label text="Médiane" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="statMediane" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="valeur"/>
                        <Label text="Écart-type" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="statEcartType" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="valeur"/>
                        <Label text="Minimum" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="statMinimum" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="valeur"/>
                        <Label text="Maximum" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="statMaximum" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="valeur"/>
                    </GridPane>
                    <BarChart fx:id="histogramme" styleClass="histogramme" title="Répartition des départements par taux de participation"
                              legendVisible="false" animated="false" prefHeight="260" HBox.hgrow="ALWAYS">
                        <xAxis><CategoryAxis label="Taux de participation"/></xAxis>
                        <yAxis><NumberAxis label="Départements" tickUnit="1" minorTickVisible="false"/></yAxis>
                    </BarChart>
                </HBox>
            </VBox>
        </TitledPane>

        <TitledPane fx:id="panneauDepartements" text="Participation, parti gagnant et parti le plus mal classé par département">
            <VBox spacing="8">
                <HBox spacing="10" styleClass="barre-filtre">
                    <Label text="Double-cliquez sur un département pour voir ses résultats." styleClass="astuce"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="filtreActif" styleClass="filtre-actif"/>
                    <Button fx:id="boutonToutAfficher" text="Afficher tous les départements" onAction="#toutAfficher"
                            styleClass="bouton-secondaire"/>
                </HBox>
                <TableView fx:id="tableDepartements" prefHeight="320">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="Aucun département"/></placeholder>
                    <columns>
                        <TableColumn fx:id="colNumero" text="N°" maxWidth="70" styleClass="centre"/>
                        <TableColumn fx:id="colNom" text="Département"/>
                        <TableColumn fx:id="colParticipation" text="Participation" styleClass="nombre"/>
                        <TableColumn fx:id="colGagnant" text="Parti gagnant" minWidth="160"/>
                        <TableColumn fx:id="colVoixGagnant" text="Voix" styleClass="nombre"/>
                        <TableColumn fx:id="colDernier" text="Plus mauvais score" minWidth="160"/>
                        <TableColumn fx:id="colVoixDernier" text="Voix" styleClass="nombre"/>
                    </columns>
                </TableView>
            </VBox>
        </TitledPane>

        <TitledPane fx:id="panneauSeuil" text="Départements où au moins 50 % des inscrits ont voté">
            <VBox spacing="6">
                <HBox spacing="10">
                    <Label fx:id="libelleSeuil"/>
                    <Slider fx:id="seuil" min="0" max="100" value="50" majorTickUnit="10" minorTickCount="0"
                            snapToTicks="false" showTickMarks="true" showTickLabels="true" prefWidth="320"/>
                    <Label fx:id="nombreAuDessusSeuil"/>
                </HBox>
                <TableView fx:id="tableSeuil" prefHeight="200">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="Aucun département n'atteint ce seuil"/></placeholder>
                    <columns>
                        <TableColumn fx:id="colSeuilNumero" text="N°" maxWidth="80" styleClass="centre"/>
                        <TableColumn fx:id="colSeuilNom" text="Nom"/>
                        <TableColumn fx:id="colSeuilTaux" text="Participation" styleClass="nombre"/>
                    </columns>
                </TableView>
            </VBox>
        </TitledPane>

        <TitledPane fx:id="panneauUnanimes" text="Départements où tous les inscrits ont voté, et pour le même parti">
            <VBox spacing="6">
                <Label fx:id="remarqueUnanimes" wrapText="true"/>
                <ListView fx:id="listeUnanimes" prefHeight="90">
                    <placeholder><Label text="Aucun département dans ce cas"/></placeholder>
                </ListView>
            </VBox>
        </TitledPane>
    </VBox>
</ScrollPane>
